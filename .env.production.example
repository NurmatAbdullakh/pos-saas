# Copy to .env.production on the VPS and replace every placeholder.
NODE_ENV=production
PORT=3000

# PostgreSQL (internal Docker network only)
POSTGRES_DB=pos_saas_db
POSTGRES_USER=pos_saas_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# JWT: generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h

DATABASE_MAX_CONNECTIONS=10

# OAuth credentials: leave empty if the provider is not configured.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
